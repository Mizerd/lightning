# Fallback entry, installed by configure-build.sh only when the source did not
# install data/lightning.desktop; keep the two in agreement. On Wayland the
# window icon comes only from Icon= here, since Qt implements no icon protocol.
[Desktop Entry]
Type=Application
Name=Lightning
Comment=Native Matrix desktop client
Exec=lightning-matrix --backend=rust
Icon=lightning
Terminal=false
Categories=Network;Chat;InstantMessaging;
Keywords=Matrix;Chat;Messaging;
StartupNotify=true
StartupWMClass=lightning-matrix
