# CI Flatpak manifest template; build-flatpak.sh substitutes the @PLACEHOLDER@
# values. It holds no secrets: the GIF provider keys reach the sandbox only
# through secret-env. The app is built from the pinned source checkout against
# the KDE runtime.
app-id: org.lightning_matrix.Lightning
runtime: org.kde.Platform
runtime-version: "6.11"
sdk: org.kde.Sdk
command: lightning

finish-args:
  # Matrix networking.
  - --share=network
  - --share=ipc
  # Native Wayland with X11 fallback, GPU rendering, notification sounds.
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri
  - --socket=pulseaudio
  # libsecret token storage (Secret Service) and desktop notifications.
  - --talk-name=org.freedesktop.secrets
  - --talk-name=org.freedesktop.Notifications
  # Portal-negotiated screen-share streams are read over the PipeWire socket.
  # Only this narrow path, never --filesystem=host: the portal decides what
  # may be captured.
  - --filesystem=xdg-run/pipewire-0
  # The camera needs no permission here: it comes from the portal Camera
  # interface (src/calls/CameraPortal.*), which returns a PipeWire remote
  # exposing only camera nodes. --device=all would expose every device and
  # is refused by Flathub.

build-options:
  # Installs the same pinned rustup toolchain as the deb job; keep it in step
  # with RUST_TOOLCHAIN in .gitlab-ci.yml. The 6.11 runtime's rust-stable
  # extension is now new enough to replace this, as the root Flathub manifest
  # does.
  prepend-path: /run/build/lightning/cargo-home/bin
  # Network for the locked cargo fetch (this is not a Flathub build).
  build-args:
    - --share=network
  env:
    CARGO_HOME: /run/build/lightning/cargo-home
    RUSTUP_HOME: /run/build/lightning/rustup
    CARGO_BUILD_JOBS: "4"
    CMAKE_BUILD_PARALLEL_LEVEL: "4"
  # Not recorded in the manifest, ostree metadata or bundle; unset in keyless
  # builds.
  secret-env:
    - LIGHTNING_BUILD_GIPHY_API_KEY
    - LIGHTNING_BUILD_KLIPY_API_KEY

modules:
  - name: lightning
    # Explicit commands instead of cmake-ninja: the build runs cargo
    # --offline --locked, so crates must be fetched first.
    #
    # This build bypasses configure-build.sh, so LIGHTNING_ARTIFACT_KIND=release
    # must be explicit; the source default ("source") would misreport
    # --build-info and enable ccache for a key-embedding build.
    buildsystem: simple
    build-commands:
      # Pinned and checksum-verified, as in .gitlab-ci.yml (RUSTUP_VERSION /
      # RUSTUP_INIT_SHA256).
      - curl --proto '=https' --tlsv1.2 -fsSL --max-redirs 3
        https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init
        -o rustup-init
      - printf '%s  rustup-init\n'
        dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
        | sha256sum -c -
      - chmod +x rustup-init
      - ./rustup-init -y --profile minimal --no-modify-path
        --default-toolchain 1.93.0
      - cargo fetch --locked --manifest-path rust/Cargo.toml
      - cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
        -DCMAKE_INSTALL_PREFIX=/app -DBUILD_TESTING=OFF
        -DENABLE_RUST_SDK_BACKEND=ON
        -DLIGHTNING_REQUIRE_GIF_KEYS=@REQUIRE_GIF_KEYS@
        -DLIGHTNING_INSTALL_TYPE=linux-flatpak
        -DLIGHTNING_UPDATE_PUBKEY_2026A=@UPDATE_SIGNING_PUBKEY_2026A@
        -DLIGHTNING_ARTIFACT_KIND=release
        -DLIGHTNING_ENABLE_WEBRTC=ON
        -DLIGHTNING_REQUIRE_WEBRTC=ON
        -DLIGHTNING_REQUIRE_QT_SVG=ON
      - cmake --build build
      - cmake --install build
      # configure-build.sh's call-engine guard, since this build bypasses it:
      # an SDK that lost the GStreamer dev files would configure the engine
      # out. Only the compiled-in line is asserted; runtime usability is
      # checked by validate-flatpak.sh.
      - /app/bin/lightning-matrix --call-media-status
        > call-media-status.txt 2>&1 || true
      - cat call-media-status.txt
      - grep -qx 'call media engine built in: yes' call-media-status.txt
    sources:
      - type: dir
        path: "@SOURCE_DIR@"
      - type: file
        path: "@METAINFO_PATH@"
        dest-filename: lightning.metainfo.xml
    post-install:
      # CMake installs the app-id-named files; only this launcher wrapper is
      # added here.
      - printf '#!/bin/sh\nexec /app/bin/lightning-matrix --backend=rust "$@"\n'
        > /app/bin/lightning && chmod 0755 /app/bin/lightning
