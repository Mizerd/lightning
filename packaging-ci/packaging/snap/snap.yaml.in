# snap.yaml template; build-snap.sh substitutes @VERSION@ and packs the
# AppImage job's bundled AppDir with mksquashfs.
#
# Not snapcraft: it needs a running snapd, which the runner fleet cannot
# provide, and core24's Qt (6.4) is older than Lightning's minimum (6.5).
# Confinement is therefore only validated structurally in CI.
#
# Under strict confinement the runtime dir is remapped to
# $XDG_RUNTIME_DIR/snap.lightning, so the launcher must bridge the Wayland,
# PipeWire and Pulse sockets one level up; core24 has no Mesa, xkb keymaps or
# fontconfig, so GL comes from the gpu-2404 plug below and the latter two are
# staged. Fonts come from the host through the `desktop` interface.
name: lightning
version: "@VERSION@"
summary: Native Matrix desktop client
description: |
  Lightning is a native C++ and Qt Matrix desktop client with the official
  Matrix Rust SDK backend. GPL-3.0-or-later.
license: GPL-3.0-or-later
base: core24
grade: stable
confinement: strict
architectures:
  - amd64
apps:
  lightning:
    command: bin/lightning-launch
    plugs:
      - network
      - network-bind
      - wayland
      - x11
      - desktop
      - desktop-legacy
      - opengl
      - audio-playback
      # The microphone; audio-playback covers output only. Not auto-connected
      # everywhere.
      - audio-record
      # v4l2src opens /dev/video* directly (autovideosrc would pick
      # pipewiresrc, which yields no frames), so the camera needs this rather
      # than the portal. Screen sharing uses the portal via `desktop`.
      - camera
      # libsecret / Secret Service access for token storage.
      - password-manager-service
      - gpu-2404

# GL from Canonical's Mesa content snap rather than a staged driver stack,
# which must match the kernel's DRM and receives its own security fixes. The
# launcher execs through the provider's wrapper when it is mounted and falls
# back to software rendering (no call video) when it is not.
#
# `default-provider` installs mesa-2404 but does not auto-connect it: content
# auto-connection requires the same publisher. Until a store declaration
# grants it, these connections are manual:
#
#   snap connect lightning:gpu-2404 mesa-2404:gpu-2404
#   snap connect lightning:audio-record
#   snap connect lightning:camera
#   snap connect lightning:password-manager-service
plugs:
  gpu-2404:
    interface: content
    target: $SNAP/gpu-2404
    default-provider: mesa-2404
