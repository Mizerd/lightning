build/
build-*/
cmake-build-*/
.cache/
.vscode/
.idea/
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
*.autosave
*.user
*.qmlproject
*.pro.user*
compile_commands.json

# Compiled translation catalogs. Build output: lrelease regenerates them from
# the tracked i18n/*.ts on every build, and CMake embeds them from the build
# tree. Tracking one would ship a stale catalog that silently wins over the
# source it came from.
*.qm

# Generated build-only GIF provider keys — never track these
generated/LightningGifBuildKeys.h
**/LightningGifBuildKeys.h

# Local secrets and environment files — never track these
lightning-gif.env
.env
*.env
!packaging/**/*.env.example

# Nix
result
result-*

# Rust (only relevant when ENABLE_RUST_SDK_BACKEND=ON)
rust/target/
target/

# Local runtime/cache data — must never be committed
matrix-client-cache/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
sessions.json
session.json
tokens.json
# Claude Code runtime state. The portable role definitions in
# .claude/agents/*.md are deliberately tracked; everything else here is
# machine-local and must never be committed.
.claude/settings.local.json
.claude/settings.local.json.backup.*
.claude/scheduled_tasks.lock
.claude/worktrees/
